<Project>

  <!--
    Central package management.

    Declare every package version used anywhere in the repository here, then
    reference packages from each .csproj WITHOUT a Version attribute:

      <PackageReference Include="Some.Package" />

    A PackageVersion entry is a version DECLARATION, not a reference - listing a
    package here does not add it to any project. Only projects that reference it
    resolve it.

    Like Directory.Build.props, this file is found by searching upward and the
    first hit wins. A nested Directory.Packages.props replaces this one for its
    subtree rather than extending it.

    Per-project escape hatches, in order of preference:
      1. <PackageReference Include="X" VersionOverride="1.2.3" />  - stays in CPM
      2. a nested Directory.Packages.props for a whole subtree
      3. <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
         in the .csproj - full opt-out, use sparingly
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Required: StyleCop.props omits its package Version when CPM is active, so
      the version must be declared here or restore fails to resolve it.
      Verify against the current release.
    -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <!-- Banned-API analyzer; the list lives in BannedSymbols.txt. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!--
    What `dotnet new webapi` and `dotnet new worker` reference. Pre-registered
    so a new service or job only needs its Version attributes stripped - see
    docs/rules/csharp-new-project.md. Both track the TFM's major: net10.0 -> 10.0.x.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <!--
    Test stack, consumed by Tests.props.

    dc-agentics-verified: sdk=10.0.400 date=2026-09-04
    Last confirmed by a clean restore, build and `dotnet test` with this exact
    combination.

    These are a KNOWN-GOOD FLOOR, not a ceiling. At repository initialization,
    try to move the whole set forward - see "Keeping the test stack current" in
    init/repo/layout.md. Update the marker above when you do.

    Known couplings - these move together or not at all:
      xunit 2.x           <-> xunit.runner.visualstudio 3.x
                              (runner 4.x targets xunit.v3)
      xunit 2.x           <-> Xunit.Combinatorial 1.x
                              (2.x pulls xunit.v3.core -> CS0433 ambiguity)
      Mvc.Testing 10.0.x  <-> net10.0
                              (tracks the ASP.NET Core version of the TFM)
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Xunit.Combinatorial" Version="1.7.31" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="FakeItEasy.Analyzer.CSharp" Version="6.1.1" />

    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="DeepEqual" Version="5.1.0" />

    <!-- FakeTimeProvider. The coding rules require time-dependent code to take
         a TimeProvider; this is how tests drive it. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />

    <!-- Version tracks the TFM's ASP.NET Core major. net10.0 -> 10.0.x -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />

    <!-- Referenced only when Tests.props enables them. -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Serilog.Sinks.TestCorrelator" Version="4.0.2" />
    <!-- Tracks the EF Core major the application uses. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
  </ItemGroup>

</Project>
